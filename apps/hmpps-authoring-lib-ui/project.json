{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@modular-data/hmpps-authoring-lib-ui",
  "projectType": "application",
  "sourceRoot": "apps/hmpps-authoring-lib-ui/src",
  "targets": {
    "sync-assets": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/public/assets"],
      "options": {
        "command": "node apps/hmpps-authoring-lib-ui/scripts/sync-gds-assets.mjs"
      }
    },
    "build": {
      "dependsOn": ["sync-assets"]
    },
    "dev": {
      "dependsOn": ["sync-assets"]
    },
    "generate-contracts": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npm exec -- openapi-ts",
        "cwd": "apps/hmpps-authoring-lib-ui",
        "envFile": "apps/hmpps-authoring-lib-ui/.env"
      }
    }
  }
}
